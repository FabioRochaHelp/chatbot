{
    "name": "myzap",
    "version": "0.2.0",
    "description": "Free OpenSource Whatsapp Api",
    "main": "index.js",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "web:install": "npm --prefix web ci",
        "web:dev": "npm --prefix web run dev",
        "build": "npm --prefix web run build",
        "postinstall": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm test && npm --prefix web run lint && npm --prefix web run typecheck"
    },
    "author": "Bill Barsch",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-better-sqlite3": "7.10.0",
        "@prisma/client": "7.10.0",
        "@wppconnect-team/wppconnect": "2.3.4",
        "axios": "1.20.0",
        "cors": "2.8.6",
        "dotenv": "16.6.1",
        "express": "4.22.3",
        "express-rate-limit": "8.7.1",
        "helmet": "8.3.0",
        "jose": "6.2.12",
        "pino": "10.4.0",
        "prisma": "7.10.0",
        "socket.io": "4.8.4",
        "swagger-ui-express": "5.0.1",
        "venom-bot": "5.3.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.12.0",
        "globals": "17.13.0",
        "pino-pretty": "13.2.0",
        "prettier": "3.9.9",
        "socket.io-client": "4.8.4",
        "supertest": "7.3.1",
        "vitest": "5.0.3"
    }
}
