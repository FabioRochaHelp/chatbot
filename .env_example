PORT=3333
ENGINE=WPPCONNECT
# ENGINE=VENOM

# Token para proteger a API (header "Authorization: Bearer <token>" ou ?token=<token>)
# deixar em branco para não exigir autenticação
API_TOKEN=

# Pasta onde ficam os tokens/perfis das sessões (no container: /usr/src/app/tokens)
# TOKENS_DIR=./tokens
# Banco SQLite e mídias (no container: /usr/src/app/data, volume myzap_data)
# DATA_DIR=./data
# DATABASE_URL=file:./data/myzap.db
# Tamanho máximo de mídia recebida que é baixada para DATA_DIR/media
# MEDIA_MAX_MB=50
# Aplicar migrations ao iniciar (0 desativa)
# DB_MIGRATE=1
# Caminho do Chromium (no container já vem configurado como /usr/bin/chromium)
# CHROME_PATH=/usr/bin/chromium

# Administrador criado no primeiro boot (se ainda não houver usuários)
# ADMIN_EMAIL=admin@seudominio.com
# ADMIN_PASSWORD=troque-esta-senha
# Segredo do login do painel (vazio = gerado e salvo em DATA_DIR/jwt-secret)
# JWT_SECRET=
# Duração do login em horas
# SESSION_TTL_HOURS=168
# Cookie só por HTTPS (padrão: igual a HTTPS). Use 1 atrás de proxy com TLS
# COOKIE_SECURE=1

# IA (Claude): chave da API da Anthropic (platform.claude.com). Sem ela a IA fica desligada
# ANTHROPIC_API_KEY=
# Fuso usado pela IA para saber a data/hora atual
# TIMEZONE=America/Sao_Paulo

# Logs: trace | debug | info | warn | error | silent
# LOG_LEVEL=info
# Origens liberadas no CORS, separadas por vírgula (vazio = qualquer origem)
# CORS_ORIGINS=https://painel.seudominio.com
# Limite de requisições por minuto por IP (0 desativa)
# RATE_LIMIT_PER_MINUTE=600
# Atrás de proxy reverso (nginx/traefik), para o rate limit enxergar o IP real
# TRUST_PROXY=1


# HTTPS=0
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.net/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.net/cert.pem
